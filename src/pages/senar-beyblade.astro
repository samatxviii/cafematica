---
const title = 'Lançador de Beyblade com LEGO SPIKE Prime | Cafemática';
const description = 'Monte um lançador de Beyblade com LEGO SPIKE Prime. Siga o manual interativo em 32 páginas para as aulas de robótica do SENAR e baixe o PDF.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/senar-beyblade/og-beyblade.jpg', Astro.site).href;
const imageAlt = 'Ilustração do lançador de Beyblade montado com LEGO SPIKE Prime, ao lado do pião.';
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonical} />
<title>{title}</title>
<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="Cafemática" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
<link rel="stylesheet" href="/senar-beyblade/viewer.css" />
</head>
<body>
<main id="viewer" aria-label="Manual interativo de montagem">
  <header><a class="tool" href="/" title="Voltar ao Cafemática" aria-label="Voltar ao Cafemática"><svg viewBox="0 0 24 24"><path d="M3 10 12 2l9 8v11h-6v-8H9v8H3Z"/></svg></a><h1>Lançador de Beyblade <small>LEGO SPIKE Prime · SENAR</small></h1><button class="tool" id="restart" title="Voltar à capa" aria-label="Voltar à capa"><svg viewBox="0 0 24 24"><path d="M3 11a9 9 0 1 1 3 7M3 4v7h7"/></svg></button></header>
  <section class="stage" aria-label="Etapa de montagem">
    <button id="prev" class="arrow prev" aria-label="Etapa anterior" title="Etapa anterior"><svg viewBox="0 0 24 24"><path d="m15 4-8 8 8 8"/></svg></button>
    <div id="viewport" class="viewport" tabindex="0" aria-label="Ilustração da etapa, área de zoom"><div id="paper" class="paper"><img id="slide" src="/senar-beyblade/slides/01.webp" alt="Capa do manual" draggable="false" /></div></div>
    <button id="next" class="arrow next" aria-label="Próxima etapa" title="Próxima etapa"><svg viewBox="0 0 24 24"><path d="m9 4 8 8-8 8"/></svg></button>
  </section>
  <footer>
    <div class="progress"><input id="progress" type="range" min="1" max="32" value="1" step="1" aria-label="Selecionar página" /><output id="counter" for="progress" aria-live="polite">Capa · 1 / 32</output></div>
    <div class="controls"><div class="tools"><button class="tool" id="minus" aria-label="Diminuir zoom" title="Diminuir zoom"><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6M7 10h6"/></svg></button><button class="tool" id="plus" aria-label="Aumentar zoom" title="Aumentar zoom"><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6M7 10h6m-3-3v6"/></svg></button><button class="tool" id="fit" aria-label="Ajustar imagem" title="Ajustar imagem"><svg viewBox="0 0 24 24"><path d="M3 9V3h6m6 0h6v6m0 6v6h-6M9 21H3v-6"/></svg></button><button class="tool" id="fullscreen" aria-label="Tela cheia" title="Tela cheia"><svg viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5m0 8v5h-5m-8 0H3v-5M3 3l6 6m12-6-6 6m6 12-6-6M3 21l6-6"/></svg></button><span id="zoom-label">100%</span></div><a class="download" href="/senar-beyblade/manual.pdf" download="SPIKE_Prime_Lancador_de_Beyblade.pdf"><svg viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg><span>PDF</span></a></div>
  </footer>
  <noscript><p>Ative o JavaScript para navegar pelas etapas ou baixe o manual em PDF.</p></noscript>
</main>
<script is:inline src="/senar-beyblade/viewer.js" defer></script>
</body></html>
