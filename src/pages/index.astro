---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import {getPosts,categories} from '../lib/content.mjs';
const posts=getPosts();
const featured=posts[0];
const rest=posts.slice(1,7);
---
<Base title="Aprender pode ser tão agradável quanto uma conversa com café" description="Matemática, LaTeX e tutoriais de Tecnologia em uma experiência de aprendizagem acolhedora, clara e interativa.">
  <div class="editorial-home">
    <section class="new-hero container" aria-labelledby="home-title">
      <div class="hero-topline"><span class="eyebrow">Um espaço para a curiosidade</span><span class="hero-index">Cafemática / ideias que aproximam</span></div>
      <div class="new-hero-grid">
        <div class="new-hero-copy">
          <h1 id="home-title">Aprender pode ser tão agradável quanto uma <span class="signature-underline">conversa com café</span></h1>
          <p>Uma forma mais leve de explorar a Matemática, descobrir o universo do LaTeX e aprender novas possibilidades da Tecnologia. Sem pressa, com clareza e curiosidade.</p>
          <div class="new-hero-actions"><a href="/blog/" class="button">Explore os artigos <Icon size={18}/></a><a href="/sobre/" class="hero-secondary">Conheça o projeto <span aria-hidden="true">↗</span></a></div>
          <div class="hero-author"><img src="/assets/prof-fernando.webp" alt="" width="40" height="40"/><span>Com Prof. Fernando Batista<br/><small>Uma ideia de cada vez.</small></span></div>
        </div>
        <div class="math-studio" data-math-studio>
          <div class="math-studio-header"><span class="studio-kicker"><span class="studio-dot"></span> LABORATÓRIO DE IDEIAS</span><span>01 / FUNÇÕES</span></div>
          <div class="studio-main"><span class="studio-eyebrow">A matemática ganha vida quando você experimenta.</span><h2>y = <span data-slope-label>2</span>x + 1</h2>
            <svg viewBox="0 0 420 300" class="studio-graph" role="img" aria-label="Gráfico de uma função linear cujo coeficiente angular pode ser alterado">
              <defs><pattern id="studio-grid" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0H0V30" fill="none" stroke="currentColor" stroke-opacity=".12"/></pattern></defs>
              <rect x="0" y="0" width="420" height="300" fill="url(#studio-grid)"/>
              <path d="M0 150H420M210 0V300" stroke="currentColor" stroke-opacity=".5" stroke-width="1.5"/>
              <path d="m409 144 11 6-11 6M204 11l6-11 6 11" fill="none" stroke="currentColor" stroke-opacity=".5"/>
              <path data-graph-line d="M0 300 L420 0" fill="none" stroke="#E6B47D" stroke-width="4" stroke-linecap="round"/>
              <circle cx="210" cy="120" r="6" fill="#E6B47D"/>
              <text x="392" y="170" fill="currentColor" font-size="13">x</text><text x="222" y="18" fill="currentColor" font-size="13">y</text>
            </svg>
          </div>
          <div class="studio-controls"><label for="slope-control">Inclinação da reta <strong data-slope-value>2</strong></label><input id="slope-control" type="range" min="-3" max="3" step="0.5" value="2"/><p>Arraste para experimentar <span aria-hidden="true">↗</span></p></div>
          <div class="studio-bottom"><span>Experimente. Observe. Entenda.</span><a href="/matematica/">Explore Matemática <Icon size={16}/></a></div>
        </div>
      </div>
      <div class="hero-scroll-cue"><span>Continue explorando</span><span aria-hidden="true">↓</span></div>
    </section>

    <section class="knowledge-section" aria-labelledby="knowledge-title">
      <div class="container"><div class="section-overline"><span>01 / CAMINHOS PARA APRENDER</span><span>Encontre seu assunto</span></div><div class="knowledge-heading"><h2 id="knowledge-title">Toda descoberta<br/>começa com uma <em>pergunta.</em></h2><p>Três portas de entrada, um só lugar para aprender. A Matemática é o nosso ponto de partida.</p></div>
        <div class="knowledge-grid">
          <a href="/matematica/" class="knowledge-main"><span class="knowledge-number">01 — NOSSO UNIVERSO PRINCIPAL</span><span class="knowledge-visual" aria-hidden="true">∫ <span>π</span> ∞</span><div class="knowledge-bottom"><div><h3>Matemática</h3><p>Da primeira dúvida àquela descoberta que muda a maneira de pensar.</p></div><span class="knowledge-arrow" aria-hidden="true">↗</span></div></a>
          <div class="knowledge-side"><a href="/latex/" class="knowledge-small latex-area"><span class="knowledge-number">02 — ESCREVA SUAS IDEIAS</span><span class="knowledge-small-symbol" aria-hidden="true">{"{ }"}</span><div class="knowledge-bottom"><div><h3>LaTeX</h3><p>Fórmulas, documentos e materiais com precisão.</p></div><span class="knowledge-arrow" aria-hidden="true">↗</span></div></a><a href="/tecnologia/" class="knowledge-small tech-area"><span class="knowledge-number">03 — FERRAMENTAS PARA CRIAR</span><span class="knowledge-small-symbol" aria-hidden="true">⌘</span><div class="knowledge-bottom"><div><h3>Tecnologia</h3><p>Tutoriais e soluções que facilitam a vida.</p></div><span class="knowledge-arrow" aria-hidden="true">↗</span></div></a></div>
        </div>
      </div>
    </section>

    <section class="container featured-section" aria-labelledby="featured-title"><div class="section-overline"><span>02 / BIBLIOTECA DE IDEIAS</span><a href="/blog/">Todos os artigos ↗</a></div><div class="featured-heading"><h2 id="featured-title">Leituras para despertar<br/><em>a curiosidade.</em></h2><p>Escolha uma boa pergunta e fique um pouco mais. Sempre há algo interessante para descobrir.</p></div>
      {featured&&<a href={`/blog/${featured.slug}/`} class="editorial-feature"><div class:list={['feature-art',featured.categoryInfo.color]}><span>EM DESTAQUE / CAFEMÁTICA</span><strong aria-hidden="true">{featured.art||featured.categoryInfo.symbol}</strong><span class="feature-art-mark">C /</span></div><div class="feature-copy"><span class="eyebrow">LEITURA EM DESTAQUE · {featured.categoryInfo.name}</span><h3>{featured.title}</h3><p>{featured.description}</p><span class="feature-read">Começar a leitura <Icon size={18}/></span><span class="feature-meta">{featured.minutes} minutos de leitura</span></div></a>}
      <div class="section-heading recent-heading"><div><span class="eyebrow">MAIS PARA EXPLORAR</span><h2>Outras boas leituras</h2></div><a href="/blog/" class="read-link">Visitar a biblioteca <Icon size={17}/></a></div><div class="post-grid editorial-post-grid">{rest.map(post=><PostCard post={post}/>)}</div>
    </section>

    <section class="manifesto-section"><div class="container manifesto-grid"><div class="manifesto-mark" aria-hidden="true">“</div><div><span class="eyebrow">UM JEITO DIFERENTE DE APRENDER</span><h2>Boas ideias merecem<br/>tempo, espaço e <em>curiosidade.</em></h2><p>O Cafemática nasceu para tornar o conhecimento mais próximo. Aqui, o importante não é decorar a resposta: é descobrir por que ela faz sentido.</p><a href="/sobre/" class="manifesto-link">A história por trás do Cafemática <Icon size={18}/></a></div><div class="manifesto-signature"><img src="/assets/prof-fernando.webp" alt="Professor Fernando Batista" width="108" height="108" loading="lazy"/><span>Prof. Fernando Batista<br/><small>Educação Matemática</small></span></div></div></section>

    <section class="container section channels-section"><div class="section-overline"><span>03 / APRENDA EM OUTROS FORMATOS</span><span>Vídeos e aulas</span></div><div class="section-heading"><div><h2>Da leitura à <em>conversa.</em></h2><p class="channels-description">Continue aprendendo com aulas, tutoriais e demonstrações em vídeo.</p></div></div><div class="channel-list">{[['01','Cafemática','Matemática Básica, ENEM e concursos: aulas para pensar e praticar.','https://www.youtube.com/@CafematicaOficial'],['02','LaTeX | Prof. Fernando','Documentos, fórmulas e materiais didáticos com exemplos práticos.','https://www.youtube.com/@LaTeX.Fernando'],['03','Teu Tutor de Tecnologia','Programas, ferramentas e soluções para o dia a dia.','https://www.youtube.com/@TTT.Fernando']].map(([n,title,description,url])=><a class="channel-card" href={url} rel="noopener noreferrer"><div class="channel-number">{n} /</div><h3>{title}</h3><p>{description}</p><span class="read-link">Conhecer o canal <Icon size={17}/></span></a>)}</div></section>
  </div>
</Base>
