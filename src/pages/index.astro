---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import {getPosts,categories} from '../lib/content.mjs';
const posts=getPosts();
---
<Base><div class="container"><section class="hero"><div class="hero-copy"><span class="eyebrow">Matemática · LaTeX · Tecnologia</span><h1>Um café.<br/>Uma ideia.<br/><em>Um novo aprendizado.</em></h1><p>Explicações que fazem sentido, ferramentas que ajudam e um professor para acompanhar o caminho.</p><div class="button-row"><a class="button" href="/blog/">Encontre seu próximo aprendizado <Icon size={17}/></a></div><div class="hero-caption"><img src="/assets/prof-fernando.webp" alt="" width="32" height="32"/>Com Prof. Fernando Batista, do Cafemática.</div></div><div class="chalkboard"><div class="chalkboard-top"><span>Uma ideia por vez</span><span class="chalkboard-tag">Do conceito à descoberta</span></div><div class="orbit"></div><div class="chalkboard-math">y = 2x + 1</div><div class="chalk-note">Parece complicado?<br/>Vamos por partes.<span>O RACIOCÍNIO VEM PRIMEIRO.</span></div><svg class="graph" viewBox="0 0 260 210" aria-hidden="true"><defs><pattern id="grid" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0V26" fill="none" stroke="#ffffff" stroke-opacity=".12"/></pattern></defs><rect x="30" y="15" width="200" height="170" fill="url(#grid)"/><path d="M30 165H238M90 190V15" fill="none" stroke="#c4cdb8" stroke-width="1.5"/><path d="m233 160 5 5-5 5M85 20l5-5 5 5" fill="none" stroke="#c4cdb8"/><path d="M62 195 152 15" stroke="#e7c889" stroke-width="3"/><circle cx="90" cy="139" r="5" fill="#e7c889"/><circle cx="116" cy="87" r="5" fill="#e7c889"/><text x="101" y="148" fill="#e2e8d8" font-size="12">b</text><text x="230" y="182" fill="#e2e8d8" font-size="12">x</text><text x="100" y="25" fill="#e2e8d8" font-size="12">y</text></svg><div class="chalkboard-bottom"><span>Entender muda tudo.</span><a href="/blog/funcao-primeiro-grau/" aria-label="Aprender função do primeiro grau"><Icon size={23}/></a></div></div></section>
<div class="topic-strip">{Object.entries(categories).map(([key,c])=><a class="topic-link" href={`/${key}/`}><span class={`topic-icon ${c.color}`}>{c.symbol}</span><div><strong>{c.name}</strong><p>{c.description}</p></div><Icon size={18}/></a>)}</div>
<section class="section"><div class="section-heading"><div><span class="eyebrow">Abra uma nova possibilidade</span><h2>Para aprender hoje</h2></div><a class="read-link" href="/blog/">Ver todos os artigos <Icon size={17}/></a></div><div class="post-grid">{posts.slice(0,6).map(post=><PostCard post={post}/>)}</div></section></div>
<section class="teacher-band"><div class="container teacher-inner"><img class="teacher-photo" src="/assets/prof-fernando.webp" alt="Professor Fernando Batista" width="210" height="210" loading="lazy"/><div><span class="eyebrow">Prazer, sou o Fernando</span><h2>Ensinar é encontrar<br/>um caminho junto.</h2><p>Sou professor de Matemática e mestre em Educação Matemática. Criei o Cafemática para aproximar o conhecimento de quem quer aprender, ensinar e descobrir novas possibilidades.</p></div><a class="button secondary" href="/sobre/">Conheça minha história <Icon size={16}/></a></div></section>
<section class="container section"><div class="section-heading"><div><span class="eyebrow">Dê o play na curiosidade</span><h2>A conversa também está no YouTube</h2></div></div><div class="channel-list">{[['01','Cafemática','Matemática Básica, ENEM e concursos: acompanhe as aulas e pratique seu raciocínio.','https://www.youtube.com/@CafematicaOficial'],['02','LaTeX | Prof. Fernando','Documentos, fórmulas e materiais didáticos, do primeiro comando às suas próprias criações.','https://www.youtube.com/@LaTeX.Fernando'],['03','Teu Tutor de Tecnologia','Aplicativos, programas e ideias para usar a tecnologia com mais autonomia.','https://www.youtube.com/@TTT.Fernando']].map(([n,title,description,url])=><a class="channel-card" href={url} rel="noopener noreferrer"><div class="channel-number">{n} /</div><h3>{title}</h3><p>{description}</p><span class="read-link">Conhecer o canal <Icon size={17}/></span></a>)}</div></section></Base>
