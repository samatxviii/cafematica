---
import Base from '../../layouts/Base.astro';import Icon from '../../components/Icon.astro';import PostCard from '../../components/PostCard.astro';import {getPosts,categories} from '../../lib/content.mjs';
const posts=getPosts();
const topicsByCategory=Object.fromEntries(Object.keys(categories).map(category=>[category,[...new Set(posts.filter(p=>p.category===category).map(p=>p.topic).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'pt-BR'))]));
---
<Base title="Artigos para aprender com clareza"><div class="container"><header class="page-intro"><span class="eyebrow">O blog do Cafemática</span><h1>Boas perguntas.<br/>Novos aprendizados.</h1><p>Escolha um assunto, siga sua curiosidade e dê o próximo passo.</p></header><section class="section" style="padding-top:0" data-blog><div class="browse-controls" id="busca"><div class="search-field"><label class="sr-only" for="article-search">Pesquisar artigos</label><Icon name="search" size={18}/><input id="article-search" type="search" placeholder="O que você quer aprender?" autocomplete="off"/></div><div class="filters" aria-label="Filtrar por assunto"><button class="filter" data-filter="all" aria-pressed="true">Todos</button>{Object.entries(categories).map(([key,c])=><button class="filter" data-filter={key} aria-pressed="false">{c.name}</button>)}</div></div><div class="blog-refine"><div class="subfilters" data-topic-container hidden><label for="article-topic">Refinar assunto</label><select id="article-topic"><option value="all">Todos os assuntos</option></select></div><div class="sort-control"><label for="article-sort">Ordenar por</label><select id="article-sort"><option value="newest">Mais recentes</option><option value="oldest">Mais antigos</option><option value="title">Título (A–Z)</option></select></div></div><script type="application/json" id="blog-topics" set:html={JSON.stringify(topicsByCategory).replace(/</g,'\\u003c')}/><p class="small muted" data-result-count aria-live="polite" style="margin-bottom:24px">{posts.length} artigos para explorar</p><div class="post-grid">{posts.map(post=><PostCard post={post}/>)}</div><p class="empty-state" data-empty hidden>Nenhum artigo encontrado. Tente outro termo ou escolha outro assunto.</p></section></div></Base>
